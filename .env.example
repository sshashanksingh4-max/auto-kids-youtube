# Core
APP_ENV=development

# Daily publishing target: 2 long + 2 Shorts per day
LONG_VIDEOS_PER_RUN=1
SHORT_VIDEOS_PER_RUN=1

# Research
EXA_API_KEY=

# Higgsfield API
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_VIDEO_MODEL=seedance_2.0
# Seedance API generation may consume credits. Keep closed until explicitly approved.
ALLOW_METERED_VIDEO_GENERATION=false
# Voice is selected from the Higgsfield voice catalog; never invent a voice ID.
HIGGSFIELD_VOICE_ID=
HIGGSFIELD_VOICE_TYPE=preset

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
